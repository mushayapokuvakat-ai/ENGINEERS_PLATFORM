// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUB_ADMIN
  USER
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum InactivityStatus {
  ACTIVE
  FLAGGED_INACTIVE
}

enum ProjectStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum TeamMemberRole {
  CREATOR
  MEMBER
}

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  username            String   @unique
  passwordHash        String
  role                Role     @default(USER)
  status              UserStatus @default(PENDING)
  profilePictureUrl   String?
  resumeUrl           String?
  lastLoginAt         DateTime?
  lastActivityAt      DateTime?
  inactivityStatus    InactivityStatus @default(ACTIVE)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  profile             Profile?
  createdProjects     Project[] @relation("CreatedBy")
  teamMemberships     TeamMember[]
  posts               Post[]
  comments            Comment[]
  likes               Like[]
  sentMessages        Message[] @relation("SentBy")
  notifications       Notification[]

  @@index([email])
  @@index([status])
  @@index([inactivityStatus])
}

model Profile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  bio                 String?
  skills              String[] @default([])
  education           String?
  experience          String?
  githubUrl           String?
  linkedinUrl         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id                  String   @id @default(cuid())
  creatorId           String
  title               String
  description         String
  techStack           String[] @default([])
  status              ProjectStatus @default(OPEN)
  maxMembers          Int      @default(5)
  deadline            DateTime?
  githubLink          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  creator             User     @relation("CreatedBy", fields: [creatorId], references: [id], onDelete: Cascade)
  teamMembers         TeamMember[]
  messages            Message[]
  posts               Post[]

  @@index([creatorId])
  @@index([status])
}

model TeamMember {
  id                  String   @id @default(cuid())
  projectId           String
  userId              String
  role                TeamMemberRole @default(MEMBER)
  joinedAt            DateTime @default(now())

  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
}

model Post {
  id                  String   @id @default(cuid())
  authorId            String
  projectId           String?
  content             String
  imageUrl            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  author              User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  project             Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comments            Comment[]
  likes               Like[]

  @@index([authorId])
  @@index([projectId])
  @@index([createdAt])
}

model Comment {
  id                  String   @id @default(cuid())
  postId              String
  authorId            String
  content             String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  post                Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author              User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([authorId])
}

model Like {
  id                  String   @id @default(cuid())
  postId              String
  userId              String
  createdAt           DateTime @default(now())

  post                Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model Message {
  id                  String   @id @default(cuid())
  senderId            String
  receiverId          String?
  projectId           String?
  content             String
  isRead              Boolean  @default(false)
  createdAt           DateTime @default(now())

  sender              User     @relation("SentBy", fields: [senderId], references: [id], onDelete: Cascade)
  project             Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([projectId])
  @@index([createdAt])
}

model Notification {
  id                  String   @id @default(cuid())
  userId              String
  type                String
  relatedId           String?
  isRead              Boolean  @default(false)
  createdAt           DateTime @default(now())

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}
